APP_NAME="URL Shortener Microservice"
APP_SUMMARY="An API for a url shortener microservice."
APP_BASE_URL="http://localhost:8000/api/v1"
APP_DOMAIN="http://localhost:8000"

# REDIS
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# POSTGRES
PG_HOST=postgres
PG_USER=pg_user_here
PG_PASSWORD=pg_password_here
PG_PORT=5432
PG_DBNAME=database_nama_here

# SECURITY
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=1
